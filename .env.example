# Copy to .env and adjust. Never commit .env.

# Warehouse (docker-compose maps it to localhost:5433). dbt reads the WAREHOUSE_* values.
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433
WAREHOUSE_USER=healthflow
WAREHOUSE_PASSWORD=change-me
WAREHOUSE_DB=healthflow_warehouse

# Used by scripts and tests when you run them on your machine (outside Docker)
WAREHOUSE_DSN=postgresql://healthflow:change-me@localhost:5433/healthflow_warehouse

# Storage backend: "local" (plain folder, fastest for development) or "azure" (Azurite or real Azure)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/bronze

# Azurite's well-known development account (public, documented by Microsoft; not a secret).
# For real Azure, use a connection string from Key Vault, or switch to managed identity in Phase 6.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;"
AZURE_STORAGE_CONTAINER=healthflow-data

# Where the simulated source system drops its daily files
LANDING_DIR=./data/landing

# Integration tests run only when this is set (point it at a throwaway database)
# HEALTHFLOW_TEST_DSN=postgresql://healthflow:change-me@localhost:5433/healthflow_test
